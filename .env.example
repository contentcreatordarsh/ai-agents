# DAYTONA_API_KEY=your_key_from_app.daytona.io

# cloud (default) | self-hosted
DAYTONA_MODE=cloud

# Optional: custom API URL (required when DAYTONA_MODE=self-hosted)
# DAYTONA_API_URL=https://your-daytona-api.example/api

# Optional region/target for cloud (e.g. us, eu)
# DAYTONA_TARGET=us

# LLM for narrative summaries (orchestrator runs on your machine, not in Cursor)
# openai | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI or any OpenAI-compatible endpoint (OpenRouter, Azure, etc.)
OPENAI_API_KEY=

# Optional base URL for OpenAI-compatible APIs
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=
